# NVIDIA NIM API keys — one per role. Get from https://build.nvidia.com
# DO NOT commit the real .env file. Copy this to .env and fill in values.

# Generators (batch=10 each)
NIM_KEY_1=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # deepseek-v4-flash
NIM_KEY_2=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # glm4.7

# Pre-filter scorers (batch=3 each)
NIM_KEY_3=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # nemotron-3-nano-30b-a3b
NIM_KEY_4=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # mistral-small-4-119b-2603

# Full scorer (batch=1)
NIM_KEY_5=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # deepseek-r1-0528

# Optional overrides
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
LOG_LEVEL=INFO
