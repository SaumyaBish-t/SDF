# Synthetic Data Forge — server-side provider configuration
#
# Copy this file to `.env` and fill in your own values.
# DO NOT commit `.env`. (.gitignore already excludes it.)
#
# Simplest setup: Ollama Cloud (one key + one model, all three roles share it).
# Advanced setup: per-role SDF_* overrides below.

# ---- Ollama Cloud (default for all three roles) ----------------------------
# Get a key from https://ollama.com → copy-paste below.
# Model is whatever you've enabled on the account (e.g. gpt-oss:120b,
# qwen2.5:72b, llama3.3:70b, deepseek-v3.1:671b, etc.).
OLLAMA_API_KEY=
OLLAMA_MODEL=
# OLLAMA_BASE_URL=https://ollama.com/v1

# ---- Per-role overrides (optional) -----------------------------------------
# If you want one role on a different provider/model, set its SDF_* trio.
# Any field left blank falls back to the OLLAMA_* values above.
#
# Generator: produces raw examples — mid-tier model, diversity > depth.
# SDF_GENERATOR_API_KEY=
# SDF_GENERATOR_MODEL=
# SDF_GENERATOR_BASE_URL=
# SDF_GENERATOR_BATCH_SIZE=5
#
# Prefilter: cheap pass/fail screen — fastest model you have.
# SDF_PREFILTER_API_KEY=
# SDF_PREFILTER_MODEL=
# SDF_PREFILTER_BASE_URL=
# SDF_PREFILTER_BATCH_SIZE=8
#
# Scorer: 5-dim rubric judge — spend the most capability here.
# SDF_SCORER_API_KEY=
# SDF_SCORER_MODEL=
# SDF_SCORER_BASE_URL=
# SDF_SCORER_BATCH_SIZE=4

# ---- Optional --------------------------------------------------------------
LOG_LEVEL=INFO
