# Synthetic Data Forge — server-side provider configuration
#
# Three roles, each independent. Point them at any OpenAI-compatible
# /chat/completions endpoint. Three different providers are fine, same
# provider for all three is fine, any combination works.
#
# Copy this file to `.env` and fill in your own values.
# DO NOT commit `.env`. (.gitignore already excludes it.)

# ---- Generator -------------------------------------------------------------
# Produces raw training examples in batches from taxonomy node-sets.
# Mid-tier model is enough; output diversity matters more than reasoning depth.
SDF_GENERATOR_API_KEY=
SDF_GENERATOR_MODEL=
SDF_GENERATOR_BASE_URL=
# SDF_GENERATOR_BATCH_SIZE=5

# ---- Prefilter -------------------------------------------------------------
# Cheap pass/fail screen on each batch — drops format/relevance/coherence
# failures before they reach the expensive scorer. Use the cheapest fast model
# you have access to; outputs are tiny verdicts so output token price barely
# matters.
SDF_PREFILTER_API_KEY=
SDF_PREFILTER_MODEL=
SDF_PREFILTER_BASE_URL=
# SDF_PREFILTER_BATCH_SIZE=8

# ---- Scorer ----------------------------------------------------------------
# Five-dimension rubric judge — accept / revise / reject. Spend the most
# capability here; a sycophantic scorer (all 5/5/5) collapses the whole
# pipeline. A reasoning-tier model is worth it.
SDF_SCORER_API_KEY=
SDF_SCORER_MODEL=
SDF_SCORER_BASE_URL=
# SDF_SCORER_BATCH_SIZE=4

# ---- Optional --------------------------------------------------------------
LOG_LEVEL=INFO
